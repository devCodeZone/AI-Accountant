# Copy this file to .env.local for local development (never commit .env.local).
# On Vercel, add the same keys in Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # "anon public" key (used only for phone OTP)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # "service_role" key — SECRET, server only

# --- App ---
APP_SESSION_SECRET=change-me-to-64-random-characters   # generate: openssl rand -hex 32
NEXT_PUBLIC_APP_URL=https://accounts.inviting-homes.com # your deployed URL (no trailing slash)

# --- Gemini AI (https://aistudio.google.com/apikey — free tier) ---
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-flash-latest                 # optional; any Gemini model id

# --- Optional ---
ENABLE_DEMO=true                                 # shows "Try the demo company" on the login page
# Fixed OTPs for testing without SMS (only these numbers): 10-digit-number:code, comma separated
# DEV_OTP_PHONES=9876543210:123456
